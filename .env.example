# Copy this file to .env and replace every <...> value. Do not commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>
SPRING_DATASOURCE_USERNAME=<database-username>
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_SECURITY_USER_NAME=<admin-username>
SPRING_SECURITY_USER_PASSWORD=<admin-password>
JWT_PUBLIC_KEY=<base64-encoded-RSA-public-key>
JWT_PRIVATE_KEY=<base64-encoded-RSA-private-key>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
APP_FRONTEND_URL=http://localhost:3000/auth/login
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
USER_CLIENT_BASE_URL=http://localhost:8081/